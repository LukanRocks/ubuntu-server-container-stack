# Docker Mounts (full `src:dst` specs, used as `- $VAR:ro` in compose files)
DOCKER_SOCK_MOUNT="/var/run/docker.sock:/var/run/docker.sock"
LOCALTIME_MOUNT="/etc/localtime:/etc/localtime"

# Docker Directories
DOCKER_CONFIG_DIR="/home/lukanvanderlinde/services/config"
DOCKER_DATA_DIR="/home/lukanvanderlinde/services/data"
DOCKER_LOGS_DIR="/home/lukanvanderlinde/services/logs"
DOCKER_MOUNTS_DIR="/home/lukanvanderlinde/services/mounts"
DOCKER_SECRETS_DIR="/home/lukanvanderlinde/services/secrets"

# Compose Categories
APPLICATIONS_DIR="/home/lukanvanderlinde/services/compose/applications"
ARR_DIR="/home/lukanvanderlinde/services/compose/arr"
INFRASTRUCTURE_DIR="/home/lukanvanderlinde/services/compose/infrastructure"
IOT_DIR="/home/lukanvanderlinde/services/compose/iot"

# General
TZ="America/Sao_Paulo"
